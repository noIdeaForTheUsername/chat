---
title: Contacts and discovery
---

flowchart TB
  classDef dashed stroke-dasharray: 5 5
  classDef serverStored stroke:#C70

  contactInfo("`
  Server-stored user contact. Includes:
  - ID of the other user
  - Public root Identity Key
  - 'Blocked' status
  - Nick ciphertext (encrypted with Data Key)
  - State version (see: Replay Protection)
  - Auth tag of all the above fields`")
  class contactInfo serverStored

  subgraph "Other user discovery"
    direction TB
    profile[("Other user's profile")]
    cert[("Other user's certificates (see: Identity Keys)")]
    class profile,cert serverStored

    cert --> certVerif["Certificate chain verification"]
    certVerif --> rootIkPub(["Root Identity Key public"])
    certVerif --> id(["User ID"])
    
    rootIkPub --> newContact["Create new contact. Trust the Root Identity Key on first use (TOFU)"]
    id --> newContact
    newContact --> authenticateNewContact["Attach authentication and associated data"]

    authenticateNewContact --> authedNewContact(["Authenticated new contact"])
    authedNewContact --> stateUpdate["State update, Contact list update, Conversation list update (see: Replay Protection)"]
    stateUpdate -->|send| serverStorage[("Server storage")]
    class stateUpdate dashed
    class serverStorage serverStored

    certVerif --> operationalIkPub(["Operational Identity Key public with associated data"])
    operationalIkPub -->|public key| profileVerif["Profile verification"]
    profile -->|signed payload| profileVerif
    profileVerif -->|verified| verifiedProfile(["Verified profile"])

  end