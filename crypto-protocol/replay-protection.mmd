---
title: Replay Protection
---
%% This refers to the server's ability to serve the client with an old state. The message replays are avoided by message numbers and not described here.
flowchart TB
  classDef serverStored stroke:#C70

  subgraph STATE
    direction TB
    %% Server
    %% The 'State' is an object encrypted and authenticated (using Master Key) by the client containing the client's keys
    %% and important informaction about their data. It provides partial prevention against the server replaying an entire old state from the past.
    encryptedState[("`Encrypted STATE. Includes:
    1. ENCRYPTED AND AUTHED:
    - Client's root keys (see: Root Keys)
    2. ONLY AUTHED:
    - State version counter (incremented by the client on each state update)
    - Conversations list
    - Contacts list`")]
    class encryptedState serverStored
    encryptedState -->|payload| stateAead

    %% Master key
    stateKey(["State key"])

    %% State
    stateKey -->|key| stateAead["AEAD"]
    stateAead --> rootKeys(["Root keys"])
    stateAead --> contactList(["Contact list"])
    stateAead --> convList(["Conversation list"])
    stateAead --> versionCounter(["State version counter"])

    %% State verification
    versionCounter --> versionComparison["Compare and reject EVERYTHING if the server-provided counter is older"]
    storedVersionCounter@{ shape: "card", label: "Stored version counter (from client device storage)"} --> versionComparison
  end

