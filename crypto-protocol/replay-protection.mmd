  %%     -->|verified| rejectWrongVersion["Each X contains State version. Reject every X with an older value"]
  %%   rejectWrongVersion --> removeDuplicateConvs["Remove duplicate IDs"]
  %%   removeDuplicateConvs --> convs(["Xs list"])
  %%   convs --> convsNumberComparison
  %%   convsNumber2(["Number of known Xs"]) --> convsNumberComparison["Comparison"]
  %%   convsNumberComparison -->|success| verifiedConvs(["Xs list"])
