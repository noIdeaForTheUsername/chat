--
-- Name: full_profiles; Type: VIEW; Schema: public; Owner: chat
--

CREATE VIEW public.full_profiles WITH (security_barrier='true') AS
 SELECT a.id,
    a.login,
    p.name,
    p.bio,
        CASE
            WHEN p.email_public THEN a.email
            ELSE NULL::text
        END AS email,
        CASE
            WHEN p.phone_number_public THEN a.phone_number
            ELSE NULL::character varying
        END AS phone_number
   FROM (public.profiles p
     JOIN public.accounts a ON ((p.id = a.id)));


ALTER VIEW public.full_profiles OWNER TO chat;

--
-- Name: VIEW full_profiles; Type: COMMENT; Schema: public; Owner: chat
--

COMMENT ON VIEW public.full_profiles IS 'Profiles merged with values from the Accounts table (email and phone number), while respecting the profile''s privacy settings (profiles.email_public etc)';


