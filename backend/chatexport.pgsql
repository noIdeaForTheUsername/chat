--
-- Name: user_conversations; Type: VIEW; Schema: public; Owner: chat
--

CREATE VIEW public.user_conversations AS
 SELECT conv.id,
    conv.type,
    p1.user_id AS owner_id,
    p2.user_id AS participant_id,
    p1.accepted,
    p1.notifications,
    p1.newest_read_message_id
   FROM ((public.participations p1
     JOIN public.participations p2 ON (((p1.conversation_id = p2.conversation_id) AND (p1.user_id <> p2.user_id))))
     JOIN public.conversations conv ON ((p1.conversation_id = conv.id)));


ALTER VIEW public.user_conversations OWNER TO chat;

--
-- Name: VIEW user_conversations; Type: COMMENT; Schema: public; Owner: chat
--

COMMENT ON VIEW public.user_conversations IS 'View that for each user that gets conversations they participate in, the conversation''s other participant ID (if it''s a direct conversation, not a group), and the user settings for this conversation (such as notifications)';


--
-- Name: user_known_profiles; Type: VIEW; Schema: public; Owner: chat
--

CREATE VIEW public.user_known_profiles AS
 SELECT p1.id AS contact_owner_id,
    p2.id,
    p2.login,
    p2.name,
    p2.bio,
    c.nick,
    c.blocked
   FROM ((public.profiles p1
     JOIN public.contacts c ON ((c.owner_id = p1.id)))
     LEFT JOIN public.full_profiles p2 ON ((c.participant_id = p2.id)));


ALTER VIEW public.user_known_profiles OWNER TO chat;

--
-- Name: VIEW user_known_profiles; Type: COMMENT; Schema: public; Owner: chat
--

COMMENT ON VIEW public.user_known_profiles IS 'Full_profiles that another specific Profile (profile.id AS contact_owner_id) has Contact with.
In other words: "all full_profiles known (via a Contact) to [contact_owner_id]".';


