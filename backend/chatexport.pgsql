CREATE VIEW public.user_messages WITH (security_barrier='true', security_invoker='false') AS
 SELECT p.user_id,
    m.global_id,
    m.conversation_id,
    m.sender_id,
    m.text,
    m."timestamp",
    m.replied_id,
    m.number_in_conversation
   FROM (public.participations p
     JOIN public.messages m ON ((m.conversation_id = p.conversation_id)));


