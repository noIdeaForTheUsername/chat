--
-- Name: latest_user_messages_per_conversation; Type: VIEW; Schema: public; Owner: chat
--

CREATE VIEW public.latest_user_messages_per_conversation AS
 SELECT DISTINCT ON (user_id, conversation_id) user_id,
    global_id,
    conversation_id,
    sender_id,
    text,
    "timestamp",
    replied_id,
    number_in_conversation
   FROM public.user_messages
  ORDER BY user_id, conversation_id, global_id DESC;


